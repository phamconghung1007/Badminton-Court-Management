<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Brand Primary Palette -->
    <Color x:Key="PrimaryColor">#1E40AF</Color>
    <Color x:Key="PrimaryDarkColor">#1E3A8A</Color>
    <Color x:Key="PrimaryLightColor">#3B82F6</Color>
    <Color x:Key="PrimaryUltraLightColor">#EFF6FF</Color>
    <Color x:Key="AccentColor">#10B981</Color>
    
    <!-- Neutral Palette -->
    <Color x:Key="BackgroundColor">#F3F4F6</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#4B5563</Color>
    <Color x:Key="TextMutedColor">#9CA3AF</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>

    <!-- Role Badges Colors -->
    <Color x:Key="RoleAdminColor">#7C3AED</Color>
    <Color x:Key="RoleManagerColor">#2563EB</Color>
    <Color x:Key="RoleStaffColor">#0D9488</Color>
    <Color x:Key="RoleCustomerColor">#D97706</Color>

    <!-- Booking Status Colors (Section 7) -->
    <Color x:Key="PendingColor">#F59E0B</Color>
    <Color x:Key="ConfirmedColor">#2563EB</Color>
    <Color x:Key="CheckedInColor">#10B981</Color>
    <Color x:Key="CompletedColor">#6B7280</Color>
    <Color x:Key="CancelledColor">#EF4444</Color>
    <Color x:Key="NoShowColor">#EA580C</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryUltraLightBrush" Color="{StaticResource PrimaryUltraLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="RoleAdminBrush" Color="{StaticResource RoleAdminColor}"/>
    <SolidColorBrush x:Key="RoleManagerBrush" Color="{StaticResource RoleManagerColor}"/>
    <SolidColorBrush x:Key="RoleStaffBrush" Color="{StaticResource RoleStaffColor}"/>
    <SolidColorBrush x:Key="RoleCustomerBrush" Color="{StaticResource RoleCustomerColor}"/>

    <SolidColorBrush x:Key="PendingBrush" Color="{StaticResource PendingColor}"/>
    <SolidColorBrush x:Key="ConfirmedBrush" Color="{StaticResource ConfirmedColor}"/>
    <SolidColorBrush x:Key="CheckedInBrush" Color="{StaticResource CheckedInColor}"/>
    <SolidColorBrush x:Key="CompletedBrush" Color="{StaticResource CompletedColor}"/>
    <SolidColorBrush x:Key="CancelledBrush" Color="{StaticResource CancelledColor}"/>
    <SolidColorBrush x:Key="NoShowBrush" Color="{StaticResource NoShowColor}"/>
</ResourceDictionary>
