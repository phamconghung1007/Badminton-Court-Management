<Window x:Class="BadmintonManager.Views.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:BadmintonManager.Converters"
        mc:Ignorable="d"
        Title="Thanh Toán Đơn Đặt Sân"
        Height="680" Width="520"
        MinHeight="580" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Window.Resources>
        <converters:MoneyConverter x:Key="MoneyConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Thu Tiền &amp; Thanh Toán"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Ghi nhận thanh toán và cập nhật trạng thái đơn"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnCancel_Click"
                        Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- Body Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- Booking Summary Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="TxtBookingCode" Text="Đơn #BK20261102-001"
                                       FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            <Border x:Name="BadgeStatus" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right" Background="#DBEAFE">
                                <TextBlock x:Name="TxtStatus" Text="Đã duyệt" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Sân &amp; Cơ sở:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtCourtAndBranch" Text="Sân 1 - Cơ sở Cầu Giấy" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Khách hàng:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtCustomerInfo" Text="Nguyễn Văn An (0911000001)" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Khung giờ chơi:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtTimeRange" Text="08:00 - 10:00 (120 phút)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,8" Background="{StaticResource BorderBrush}"/>

                        <!-- Financial Summary -->
                        <Grid Margin="0,2">
                            <TextBlock Text="Tổng tiền sân:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtFinalAmount" Text="120.000 đ" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Đã thanh toán:" FontSize="12" Foreground="#15803D"/>
                            <TextBlock x:Name="TxtTotalPaid" Text="36.000 đ" FontSize="12" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <TextBlock Text="Còn lại phải thu:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            <TextBlock x:Name="TxtRemainingAmount" Text="84.000 đ" FontSize="14" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Payment Form Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN GIAO DỊCH" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                        <!-- Payment Type: Deposit vs Final -->
                        <TextBlock Text="Loại thanh toán:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="RbDeposit" Content="Đặt cọc tiền sân" Margin="0,0,16,0" Checked="RbPaymentType_Changed"/>
                            <RadioButton x:Name="RbFinal" Content="Thanh toán tiền sân" IsChecked="True" Checked="RbPaymentType_Changed"/>
                        </StackPanel>

                        <!-- Quick Amount Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnQuickDeposit" Click="BtnQuickDeposit_Click"
                                    Style="{StaticResource OutlineButtonStyle}" Height="28" Padding="8,0" Margin="0,0,6,0" FontSize="11">
                                <TextBlock Text="Cọc 30%"/>
                            </Button>
                            <Button x:Name="BtnQuickRemaining" Click="BtnQuickRemaining_Click"
                                    Style="{StaticResource OutlineButtonStyle}" Height="28" Padding="8,0" FontSize="11">
                                <TextBlock Text="Thu đủ nợ còn lại"/>
                            </Button>
                        </StackPanel>

                        <!-- Amount Input -->
                        <TextBox x:Name="TxtAmount"
                                 materialDesign:HintAssist.Hint="Số tiền thu (VNĐ) *"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"
                                 Margin="0,0,0,14"/>

                        <!-- Payment Method -->
                        <TextBlock Text="Phương thức thanh toán:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="RbCash" Content="Tiền mặt" IsChecked="True" Margin="0,0,16,0" Checked="RbMethod_Changed"/>
                            <RadioButton x:Name="RbBankTransfer" Content="Chuyển khoản (Ngân hàng / QR)" Checked="RbMethod_Changed"/>
                        </StackPanel>

                        <!-- Reference No (if BankTransfer) -->
                        <TextBox x:Name="TxtReferenceNo"
                                 materialDesign:HintAssist.Hint="Mã giao dịch / Mã tham chiếu chuyển khoản"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Margin="0,0,0,14" Visibility="Collapsed"/>

                        <!-- Note -->
                        <TextBox x:Name="TxtNote"
                                 materialDesign:HintAssist.Hint="Ghi chú thanh toán (tùy chọn)"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="BtnCancel_Click"
                        Style="{StaticResource OutlineButtonStyle}"
                        Content="Hủy bỏ" Width="90" Height="38" Margin="0,0,10,0"/>

                <Button x:Name="BtnConfirmPayment" Click="BtnConfirmPayment_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="38" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashCheck" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Xác Nhận Thu Tiền" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
