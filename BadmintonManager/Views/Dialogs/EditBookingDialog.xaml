<Window x:Class="BadmintonManager.Views.Dialogs.EditBookingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Chỉnh Sửa Đơn Đặt Sân"
        Height="620" Width="480"
        MinHeight="540" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Chỉnh Sửa Lịch Đặt Sân"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    <TextBlock Text="Đổi sân thi đấu hoặc khung giờ chơi (chỉ áp dụng trước giờ bắt đầu)"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnCancel_Click"
                        Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- Body Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- Info Summary -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="TxtCustomerInfo" Text="Khách hàng: Nguyễn Văn An"
                                   FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtOriginalTime" Text="Lịch cũ: 08:00 - 10:00 (Sân 1)"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Edit Inputs Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ĐIỀU CHỈNH SÂN &amp; THỜI GIAN" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <!-- Court Selector -->
                        <ComboBox x:Name="CbCourt"
                                  materialDesign:HintAssist.Hint="Chọn sân thi đấu mới *"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  SelectionChanged="Input_Changed" Margin="0,0,0,14"/>

                        <!-- Date Picker -->
                        <DatePicker x:Name="DpDate"
                                    materialDesign:HintAssist.Hint="Ngày thi đấu *"
                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                    SelectedDateChanged="Input_Changed" Margin="0,0,0,14"/>

                        <!-- Time Options -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="CbStartTime" Grid.Column="0"
                                      materialDesign:HintAssist.Hint="Giờ bắt đầu *"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      SelectionChanged="Input_Changed" Margin="0,0,6,0"/>

                            <ComboBox x:Name="CbEndTime" Grid.Column="1"
                                      materialDesign:HintAssist.Hint="Giờ kết thúc *"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      SelectionChanged="Input_Changed" Margin="6,0,0,0"/>
                        </Grid>

                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Thời lượng mới: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDuration" Text="120 phút" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Price Preview Card -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="TẠM TÍNH TIỀN SAU ĐIỀU CHỈNH" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,2">
                            <TextBlock Text="Đơn giá gốc:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtSubTotal" Text="120.000 đ" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="Chiết khấu hội viên:" FontSize="12" Foreground="#15803D"/>
                            <TextBlock x:Name="TxtDiscount" Text="-12.000 đ" FontSize="12" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,4" Background="#BFDBFE"/>
                        <Grid Margin="0,2">
                            <TextBlock Text="Tổng tiền mới:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            <TextBlock x:Name="TxtNewFinalAmount" Text="108.000 đ" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="TxtPricingNote" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="BtnCancel_Click"
                        Style="{StaticResource OutlineButtonStyle}"
                        Content="Hủy bỏ" Width="90" Height="38" Margin="0,0,10,0"/>

                <Button x:Name="BtnSave" Click="BtnSave_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="38" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Lưu Thay Đổi" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
