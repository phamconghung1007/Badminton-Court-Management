<Window x:Class="BadmintonManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Đăng nhập - Hệ Thống Quản Lý Sân Cầu Lông"
        Height="780" Width="1100"
        MinHeight="600" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}">

    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Background decorative ambient circles -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="420" Height="420"
                Background="{StaticResource PrimaryUltraLightBrush}"
                CornerRadius="210"
                Margin="0,-160,-160,0"
                Opacity="0.7"
                IsHitTestVisible="False"/>
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Width="320" Height="320"
                Background="{StaticResource PrimaryUltraLightBrush}"
                CornerRadius="160"
                Margin="-110,0,0,-110"
                Opacity="0.5"
                IsHitTestVisible="False"/>

        <!-- Main Scrollable Container (ensures zero clipping on any screen resolution or scaling) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Margin="24">
                
                <!-- Center Login Card -->
                <Border Width="480"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="16"
                        Padding="36,32"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Effect="{DynamicResource MaterialDesignElevationShadow4}">
                    <StackPanel>
                        <!-- Header Icon & Title -->
                        <Border Width="64" Height="64"
                                CornerRadius="32"
                                Background="{StaticResource PrimaryUltraLightBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Badminton"
                                                     Width="36" Height="36"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>

                        <TextBlock Text="QUẢN LÝ SÂN CẦU LÔNG"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource PrimaryDarkBrush}"/>

                        <TextBlock Text="Đăng nhập vào hệ thống để tiếp tục"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,24"/>

                        <!-- Username Input -->
                        <TextBox x:Name="TxtUsername"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Tên đăng nhập"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 FontSize="14"
                                 Margin="0,0,0,16"/>

                        <!-- Password Input -->
                        <PasswordBox x:Name="TxtPassword"
                                     PasswordChanged="TxtPassword_PasswordChanged"
                                     materialDesign:HintAssist.Hint="Mật khẩu"
                                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                     FontSize="14"
                                     Margin="0,0,0,24"/>

                        <!-- Login Button -->
                        <Button Command="{Binding LoginCommand}"
                                Content="ĐĂNG NHẬP"
                                Height="44"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,0,10"/>

                        <!-- Register Link Button -->
                        <Button Command="{Binding OpenRegisterCommand}"
                                Content="Chưa có tài khoản? Đăng ký ngay"
                                Height="32"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource PrimaryBrush}"
                                FontSize="12"
                                Margin="0,0,0,12"/>

                        <!-- Loading Indicator -->
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Margin="0,0,0,16"/>

                        <!-- Demo Hint Box with Quick-Fill buttons -->
                        <Border Background="#F9FAFB"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Margin="0,4,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="LightbulbOutline" Width="16" Height="16"
                                                             Foreground="{StaticResource PrimaryBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tài khoản mẫu (Mật khẩu: 123456) - Bấm chọn nhanh:"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Column 0: Admin & Manager -->
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <Button Click="QuickFillAccount_Click" Tag="admin"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,4" Margin="0,2"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ShieldCrown" Width="14" Height="14" Foreground="{StaticResource RoleAdminBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Admin: admin" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="QuickFillAccount_Click" Tag="manager1"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,4" Margin="0,2"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountTie" Width="14" Height="14" Foreground="{StaticResource RoleManagerBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Manager: manager1" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Column 1: Staff & Customer -->
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <Button Click="QuickFillAccount_Click" Tag="staff1_1"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,4" Margin="0,2"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="BadgeAccountHorizontal" Width="14" Height="14" Foreground="{StaticResource RoleStaffBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Staff: staff1_1" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="QuickFillAccount_Click" Tag="customer1"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,4" Margin="0,2"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Height="32">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountStar" Width="14" Height="14" Foreground="{StaticResource RoleCustomerBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Customer: customer1" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
