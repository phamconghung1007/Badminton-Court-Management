<Window x:Class="BadmintonManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Đăng nhập - Hệ Thống Quản Lý Sân Cầu Lông"
        Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid Margin="32">
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="32"
                Effect="{DynamicResource MaterialDesignElevationShadow4}">
            <StackPanel VerticalAlignment="Center">
                <!-- Header Icon & Title -->
                <materialDesign:PackIcon Kind="Badminton"
                                         Width="56" Height="56"
                                         HorizontalAlignment="Center"
                                         Foreground="{StaticResource PrimaryBrush}"
                                         Margin="0,0,0,12"/>

                <TextBlock Text="QUẢN LÝ SÂN CẦU LÔNG"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>

                <TextBlock Text="Đăng nhập vào hệ thống để tiếp tục"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,24"/>

                <!-- Username Input -->
                <TextBox x:Name="TxtUsername"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Tên đăng nhập"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="14"
                         Margin="0,0,0,16"/>

                <!-- Password Input -->
                <PasswordBox x:Name="TxtPassword"
                             PasswordChanged="TxtPassword_PasswordChanged"
                             materialDesign:HintAssist.Hint="Mật khẩu"
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             FontSize="14"
                             Margin="0,0,0,24"/>

                <!-- Login Button -->
                <Button Command="{Binding LoginCommand}"
                        Content="ĐĂNG NHẬP"
                        Height="44"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,0,12"/>

                <!-- Register Link Button -->
                <Button Command="{Binding OpenRegisterCommand}"
                        Content="Chưa có tài khoản? Đăng ký ngay"
                        Height="32"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{StaticResource PrimaryBrush}"
                        FontSize="12"
                        Margin="0,0,0,12"/>

                <!-- Loading Indicator -->
                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             Margin="0,0,0,16"/>

                <!-- Demo Hint Box -->
                <Border Background="#F9FAFB"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="💡 Tài khoản mẫu (Mật khẩu: 123456):"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="• Admin: admin" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="• Manager: manager1 (Cầu Giấy)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="• Staff: staff1_1 (Cầu Giấy)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="• Customer: customer1" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
