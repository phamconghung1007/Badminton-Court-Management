<Window x:Class="BadmintonManager.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Đăng ký tài khoản khách hàng"
        Height="620" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28">
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="28"
                Effect="{DynamicResource MaterialDesignElevationShadow4}">
            <StackPanel VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="AccountPlus"
                                         Width="48" Height="48"
                                         HorizontalAlignment="Center"
                                         Foreground="{StaticResource PrimaryBrush}"
                                         Margin="0,0,0,8"/>

                <TextBlock Text="ĐĂNG KÝ THÀNH VIÊN"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>

                <TextBlock Text="Tạo tài khoản để đặt sân trực tuyến &amp; tích điểm"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,16"/>

                <!-- Full Name -->
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Họ và tên khách hàng *"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="13"
                         Margin="0,0,0,10"/>

                <!-- Phone -->
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Số điện thoại *"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="13"
                         Margin="0,0,0,10"/>

                <!-- Username -->
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Tên đăng nhập *"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="13"
                         Margin="0,0,0,10"/>

                <!-- Password -->
                <PasswordBox x:Name="TxtPassword"
                             PasswordChanged="TxtPassword_PasswordChanged"
                             materialDesign:HintAssist.Hint="Mật khẩu (ít nhất 6 ký tự) *"
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             FontSize="13"
                             Margin="0,0,0,10"/>

                <!-- Confirm Password -->
                <PasswordBox x:Name="TxtConfirmPassword"
                             PasswordChanged="TxtConfirmPassword_PasswordChanged"
                             materialDesign:HintAssist.Hint="Xác nhận mật khẩu *"
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             FontSize="13"
                             Margin="0,0,0,16"/>

                <!-- Register Button -->
                <Button Command="{Binding RegisterCommand}"
                        Content="ĐĂNG KÝ TÀI KHOẢN"
                        Height="40"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,0,8"/>

                <!-- Cancel / Back Button -->
                <Button Command="{Binding CancelCommand}"
                        Content="Quay lại đăng nhập"
                        Height="36"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{StaticResource TextSecondaryBrush}"/>

                <!-- Loading Indicator -->
                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
