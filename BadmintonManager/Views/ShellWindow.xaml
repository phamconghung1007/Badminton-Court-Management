<Window x:Class="BadmintonManager.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:adminVm="clr-namespace:BadmintonManager.ViewModels.Admin"
        xmlns:mgrVm="clr-namespace:BadmintonManager.ViewModels.Manager"
        xmlns:staffVm="clr-namespace:BadmintonManager.ViewModels.Staff"
        xmlns:custVm="clr-namespace:BadmintonManager.ViewModels.Customer"
        xmlns:sharedVm="clr-namespace:BadmintonManager.ViewModels.Shared"
        xmlns:baseVm="clr-namespace:BadmintonManager.ViewModels.Base"
        xmlns:pages="clr-namespace:BadmintonManager.Views.Pages"
        mc:Ignorable="d"
        Title="Hệ Thống Quản Lý Sân Cầu Lông"
        Height="850" Width="1360"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- ViewModel to View Mapping DataTemplates -->
        <DataTemplate DataType="{x:Type adminVm:AdminDashboardViewModel}">
            <pages:AdminDashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type mgrVm:ManagerDashboardViewModel}">
            <pages:ManagerDashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type staffVm:StaffDashboardViewModel}">
            <pages:StaffDashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type custVm:CustomerDashboardViewModel}">
            <pages:CustomerDashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sharedVm:UserProfileViewModel}">
            <pages:UserProfilePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type baseVm:PlaceholderPageViewModel}">
            <pages:PlaceholderPageView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Logo & Brand -->
                <Border Grid.Row="0"
                        Padding="20"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Badminton"
                                                 Width="36" Height="36"
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BADMINTON"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="{StaticResource PrimaryDarkBrush}"/>
                            <TextBlock Text="Management System"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dynamic Role Navigation Menu -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                         Margin="8,12,8,12"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                         Grid.Column="0"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding Title}"
                                           Grid.Column="1"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- User Profile & Logout -->
                <Border Grid.Row="2"
                        Padding="16"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Background="#FAFAFA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding CurrentUserName}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentUserRole}"
                                       FontSize="11"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding CurrentBranchInfo}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,8"/>
                        </StackPanel>

                        <Button Grid.Row="1"
                                Command="{Binding LogoutCommand}"
                                Height="34"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Foreground="{StaticResource CancelledBrush}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="8,4">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Đăng xuất" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Viewport / Main Workspace -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPageViewModel}" />
        </Grid>
    </Grid>
</Window>
