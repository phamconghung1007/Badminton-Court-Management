<UserControl x:Class="BadmintonManager.Views.Pages.AdminPricingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:BadmintonManager.Converters"
             xmlns:enums="clr-namespace:BadmintonManager.Models.Enums"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:MoneyConverter x:Key="MoneyConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Cấu hình Bảng giá &amp; Khung giờ"
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Thiết lập đơn giá theo từng khung giờ và loại ngày. Tuân thủ tiêu chuẩn BR-10 phủ kín 06:00 - 24:00."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Filter DayType -->
                <ComboBox SelectedIndex="{Binding SelectedDayTypeFilterIndex, Mode=TwoWay}"
                          Width="190" Margin="0,0,12,0"
                          materialDesign:HintAssist.Hint="Lọc theo loại ngày"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                    <ComboBoxItem Content="Tất cả loại ngày"/>
                    <ComboBoxItem Content="Ngày thường (T2 - T6)"/>
                    <ComboBoxItem Content="Cuối tuần (T7 - CN)"/>
                </ComboBox>

                <Button Command="{Binding CheckCoverageCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,10,0" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Kiểm tra BR-10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding LoadRulesCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,10,0" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenAddFormCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Thêm khung giá" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- BR-10 Coverage Status Banners -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Weekday Status Card -->
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F0FDF4"/>
                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WeekdayCoverageValid}" Value="False">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Foreground" Value="#16A34A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WeekdayCoverageValid}" Value="False">
                                        <Setter Property="Kind" Value="AlertCircleOutline"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="NGÀY THƯỜNG (Thứ 2 - Thứ 6)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding WeekdayCoverageSummary}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#15803D"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WeekdayCoverageValid}" Value="False">
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding WeekdayCoverageErrorsText}"
                                   Visibility="{Binding WeekdayCoverageValid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                                   FontSize="11" Foreground="#991B1B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Weekend Status Card -->
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" CornerRadius="8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F0FDF4"/>
                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WeekendCoverageValid}" Value="False">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Foreground" Value="#16A34A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WeekendCoverageValid}" Value="False">
                                        <Setter Property="Kind" Value="AlertCircleOutline"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CUỐI TUẦN (Thứ 7 &amp; Chủ Nhật)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding WeekendCoverageSummary}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#15803D"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WeekendCoverageValid}" Value="False">
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding WeekendCoverageErrorsText}"
                                   Visibility="{Binding WeekendCoverageValid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                                   FontSize="11" Foreground="#991B1B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Main Content Area: Rules List & Side Editor -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Price Rules Table -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding Rules}"
                          SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Loại ngày" Binding="{Binding DayTypeName}" Width="1.5*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Khung giờ" Binding="{Binding TimeRange}" Width="1.5*" FontWeight="Bold"/>
                        <DataGridTemplateColumn Header="Thời lượng" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DurationMinutes, StringFormat='{}{0} phút'}"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Đơn giá / giờ" Binding="{Binding PricePerHour, Converter={StaticResource MoneyConverter}}" Width="1.5*" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action Buttons -->
                        <DataGridTemplateColumn Header="Thao tác" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Chỉnh sửa khung giá"
                                                Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Width="32" Height="32">
                                            <materialDesign:PackIcon Kind="PencilOutline" Foreground="{StaticResource PrimaryBrush}"/>
                                        </Button>

                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Bật/Tắt áp dụng"
                                                Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Width="32" Height="32">
                                            <materialDesign:PackIcon Kind="Power" Foreground="{StaticResource CancelledBrush}"/>
                                        </Button>

                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Xoá khung giá"
                                                Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Width="32" Height="32">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Side Drawer Form for Add/Edit -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                    Width="380"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding FormTitle}"
                                   FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding CloseFormCommand}"
                                HorizontalAlignment="Right" Width="28" Height="28">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                    </Grid>

                    <!-- Form Input Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <!-- DayType Dropdown -->
                            <TextBlock Text="Loại ngày áp dụng *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding FormDayType, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Margin="0,0,0,16"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                <ComboBoxItem Content="Ngày thường (Thứ 2 - Thứ 6)" Tag="{x:Static enums:DayType.Weekday}"/>
                                <ComboBoxItem Content="Cuối tuần (Thứ 7 &amp; Chủ Nhật)" Tag="{x:Static enums:DayType.Weekend}"/>
                            </ComboBox>

                            <!-- Start Time Dropdown -->
                            <TextBlock Text="Giờ bắt đầu (06:00 - 23:30) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding StartTimeOptions}"
                                      SelectedItem="{Binding SelectedStartOption, Mode=TwoWay}"
                                      DisplayMemberPath="Display"
                                      Margin="0,0,0,16"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <!-- End Time Dropdown -->
                            <TextBlock Text="Giờ kết thúc (06:30 - 24:00) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding EndTimeOptions}"
                                      SelectedItem="{Binding SelectedEndOption, Mode=TwoWay}"
                                      DisplayMemberPath="Display"
                                      Margin="0,0,0,16"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <!-- Price Per Hour -->
                            <TextBlock Text="Đơn giá theo giờ (VNĐ/giờ) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormPricePerHourText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Ví dụ: 80000"
                                     Margin="0,0,0,16"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <!-- Active Checkbox -->
                            <CheckBox IsChecked="{Binding FormIsActive, Mode=TwoWay}"
                                      Content="Kích hoạt áp dụng ngay (Kiểm tra BR-10 chống trùng lấn)"
                                      Margin="0,4,0,16"/>

                            <!-- Error Message Display -->
                            <TextBlock Text="{Binding FormErrorMessage}"
                                       Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"
                                       Visibility="{Binding FormErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Form Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Huỷ bỏ"
                                Command="{Binding CloseFormCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Margin="0,0,8,0" Width="90" Height="36"/>
                        <Button Content="Lưu khung giá"
                                Command="{Binding SaveRuleCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
