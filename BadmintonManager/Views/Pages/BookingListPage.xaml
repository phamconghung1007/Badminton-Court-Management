<UserControl x:Class="BadmintonManager.Views.Pages.BookingListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:BadmintonManager.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:MoneyConverter x:Key="MoneyConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Danh Sách Phiếu Đặt Sân"
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Tra cứu, lọc trạng thái, duyệt đơn và check-in vào sân."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,10,0" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Xóa lọc" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding LoadBookingsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- KPI Statistic Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ ĐƠN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Pending -->
            <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A"
                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CHỜ DUYỆT" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                    <TextBlock Text="{Binding PendingCount}" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Confirmed -->
            <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE"
                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="ĐÃ DUYỆT" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                    <TextBlock Text="{Binding ConfirmedCount}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Checked-in -->
            <Border Grid.Column="3" Background="#F0FDF4" BorderBrush="#BBF7D0"
                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="ĐANG CHƠI" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                    <TextBlock Text="{Binding CheckedInCount}" FontSize="20" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 5: Total Revenue -->
            <Border Grid.Column="4" Background="#F5F3FF" BorderBrush="#DDD6FE"
                    BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="DOANH SỐ HIỆN TẠI" FontSize="11" FontWeight="Bold" Foreground="#6D28D9"/>
                    <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource MoneyConverter}}" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter Bar -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date Filter -->
                <DatePicker Grid.Column="0" SelectedDate="{Binding FilterDate, Mode=TwoWay}"
                            materialDesign:HintAssist.Hint="Lọc theo ngày" Margin="0,0,12,0"
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>

                <!-- Status Filter -->
                <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedStatusFilterIndex, Mode=TwoWay}"
                          materialDesign:HintAssist.Hint="Trạng thái" Margin="0,0,12,0"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                    <ComboBoxItem Content="Tất cả trạng thái"/>
                    <ComboBoxItem Content="Chờ duyệt (Pending)"/>
                    <ComboBoxItem Content="Đã duyệt (Confirmed)"/>
                    <ComboBoxItem Content="Đã check-in (CheckedIn)"/>
                    <ComboBoxItem Content="Hoàn thành (Completed)"/>
                    <ComboBoxItem Content="Đã hủy (Cancelled)"/>
                    <ComboBoxItem Content="Vắng mặt (NoShow)"/>
                </ComboBox>

                <!-- Court Filter -->
                <ComboBox Grid.Column="2" ItemsSource="{Binding CourtFilters}"
                          SelectedItem="{Binding SelectedCourtFilter, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          materialDesign:HintAssist.Hint="Tất cả sân đấu" Margin="0,0,12,0"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                <!-- Search Keyword -->
                <TextBox Grid.Column="3" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Tìm theo mã đơn, tên khách, SĐT, sân..." Margin="0,0,12,0"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Search Button -->
                <Button Grid.Column="4" Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Height="36" Width="80">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Tìm" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Bookings DataGrid -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Bookings}"
                      SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="52">
                <DataGrid.Columns>
                    <!-- Code -->
                    <DataGridTemplateColumn Header="Mã Đơn" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Code, StringFormat='#{0}'}"
                                           FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"
                                           VerticalAlignment="Center" Margin="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Court & Branch -->
                    <DataGridTemplateColumn Header="Sân &amp; Cơ sở" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding CourtName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding BranchName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Customer -->
                    <DataGridTemplateColumn Header="Khách Hàng" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DisplayPhone}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Time & Date -->
                    <DataGridTemplateColumn Header="Giờ Chơi" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding TimeRangeText}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding StartTime, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Amount -->
                    <DataGridTemplateColumn Header="Thành Tiền" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding FinalAmount, Converter={StaticResource MoneyConverter}}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                    <TextBlock Text="{Binding DepositAmount, Converter={StaticResource MoneyConverter}, StringFormat='Cọc: {0}'}" FontSize="10" Foreground="#D97706"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Trạng Thái" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Default Confirmed -->
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCheckedIn}" Value="True">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1E40AF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCheckedIn}" Value="True">
                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Foreground" Value="#4B5563"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Thao Tác" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <!-- Duyệt (Pending) -->
                                    <Button Command="{Binding DataContext.ConfirmBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="10,0" Height="28" Margin="0,0,6,0" FontSize="11">
                                        <TextBlock Text="Duyệt đơn"/>
                                    </Button>

                                    <!-- Check-in (Confirmed) -->
                                    <Button Command="{Binding DataContext.CheckInBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsConfirmed, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Background="#10B981" BorderBrush="#059669"
                                            Padding="10,0" Height="28" Margin="0,0,6,0" FontSize="11">
                                        <TextBlock Text="Check-in"/>
                                    </Button>

                                    <!-- Hủy (Pending or Confirmed) -->
                                    <Button Command="{Binding DataContext.CancelBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            BorderBrush="#EF4444" Foreground="#EF4444"
                                            Padding="8,0" Height="28" FontSize="11">
                                        <TextBlock Text="Hủy"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>