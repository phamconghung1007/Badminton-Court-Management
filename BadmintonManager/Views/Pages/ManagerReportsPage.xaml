<UserControl x:Class="BadmintonManager.Views.Pages.ManagerReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:BadmintonManager.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <converters:MoneyConverter x:Key="MoneyConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Filters -->
            <RowDefinition Height="Auto" /> <!-- KPI Cards -->
            <RowDefinition Height="*" />    <!-- Content & Charts -->
        </Grid.RowDefinitions>

        <!-- SECTION 1: HEADER & FILTER TOOLBAR -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title & Quick Filters -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartBox" Width="28" Height="28" Foreground="#1E3A8A" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BÁO CÁO DOANH THU &amp; HIỆU SUẤT CƠ SỞ" FontSize="22" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
                            
                            <!-- Branch Badge -->
                            <Border Background="#EFF6FF" CornerRadius="16" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Domain" Width="16" Height="16" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding BranchName}" Foreground="#1E3A8A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Số liệu thống kê hoạt động kinh doanh và hiệu suất sân thuộc phạm vi quản lý của cơ sở." 
                                   Foreground="#6B7280" FontSize="13" Margin="38,4,0,0"/>
                    </StackPanel>

                    <!-- Quick Date Range Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Hôm nay" Command="{Binding FilterTodayCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Margin="0,0,6,0" Padding="10,0"/>
                        <Button Content="Tuần này" Command="{Binding FilterThisWeekCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Margin="0,0,6,0" Padding="10,0"/>
                        <Button Content="Tháng này" Command="{Binding FilterThisMonthCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Margin="0,0,6,0" Padding="10,0"/>
                        <Button Content="30 ngày qua" Command="{Binding FilterLast30DaysCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Padding="10,0"/>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#E5E7EB"/>

                <!-- Filter Inputs Row -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- From Date -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Từ ngày:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#374151"/>
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130" Height="36" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="Đến ngày:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#374151"/>
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130" Height="36" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Action Button -->
                    <Button Grid.Column="2" Command="{Binding LoadReportsCommand}" Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#1E3A8A" BorderBrush="#1E3A8A" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Xem Báo Cáo Cơ Sở" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Busy Indicator -->
                    <ProgressBar Grid.Column="3" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                 IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- SECTION 2: 4 KPI CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Doanh thu cơ sở -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,10,0" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DOANH THU CƠ SỞ" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Summary.TotalRevenue, Converter={StaticResource MoneyConverter}, FallbackValue='0 VNĐ'}" 
                                   FontSize="20" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="8" Width="44" Height="44" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CurrencyUsd" Width="26" Height="26" Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Lượt đặt sân cơ sở -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" Margin="5,0,5,0" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LƯỢT ĐẶT TẠI CƠ SỞ" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Summary.TotalBookings, StringFormat='{}{0:N0} đơn', FallbackValue='0 đơn'}" 
                                   FontSize="20" FontWeight="Bold" Foreground="#1E3A8A"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="8" Width="44" Height="44" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CalendarCheck" Width="26" Height="26" Foreground="#1E3A8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Số giờ chơi cơ sở -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16" Margin="5,0,5,0" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="GIỜ HOẠT ĐỘNG" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Summary.TotalBookedHours, StringFormat='{}{0:N1} giờ', FallbackValue='0.0 giờ'}" 
                                   FontSize="20" FontWeight="Bold" Foreground="#D97706"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FFFBEB" CornerRadius="8" Width="44" Height="44" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="26" Height="26" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Tỷ lệ lấp đầy cơ sở -->
            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="16" Margin="10,0,0,0" materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TỶ LỆ LẤP ĐẦY SÂN" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Summary.AverageUtilizationRate, StringFormat='{}{0:N1}%', FallbackValue='0.0%'}" 
                                   FontSize="20" FontWeight="Bold" Foreground="#0D9488"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F0FDFA" CornerRadius="8" Width="44" Height="44" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ChartPie" Width="26" Height="26" Foreground="#0D9488" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- SECTION 3: TABS FOR DETAILED REPORTS & CHARTS -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2">
            <TabControl SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">

                <!-- TAB 1: DOANH THU THEO NGÀY -->
                <TabItem Header="📊 Doanh Thu Theo Ngày" FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!-- LiveCharts Column Chart -->
                        <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Doanh thu theo ngày tại chi nhánh (VNĐ)" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>
                                <lvc:CartesianChart Grid.Row="1" Series="{Binding RevenueSeries}" XAxes="{Binding RevenueXAxes}"/>
                            </Grid>
                        </Border>

                        <!-- Daily Revenue Data Grid -->
                        <Border Grid.Column="1" Background="#F9FAFB" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Chi tiết doanh thu chi nhánh" FontWeight="Bold" Foreground="#374151" Margin="4,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding DailyRevenues}" AutoGenerateColumns="False" 
                                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày" Binding="{Binding Date, StringFormat='dd/MM/yyyy'}" Width="100"/>
                                        <DataGridTextColumn Header="Số đơn" Binding="{Binding BookingCount}" Width="80"/>
                                        <DataGridTextColumn Header="Doanh thu (VNĐ)" Binding="{Binding TotalRevenue, Converter={StaticResource MoneyConverter}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: TỶ LỆ LẤP ĐẦY TỪNG SÂN -->
                <TabItem Header="🏸 Tỷ Lệ Lấp Đầy Sân Cơ Sở" FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!-- Occupancy Chart -->
                        <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Biểu đồ tỷ lệ lấp đầy các sân của cơ sở (%)" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,12"/>
                                <lvc:CartesianChart Grid.Row="1" Series="{Binding OccupancySeries}" XAxes="{Binding OccupancyXAxes}"/>
                            </Grid>
                        </Border>

                        <!-- Courts Table -->
                        <Border Grid.Column="1" Background="#F9FAFB" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Bảng hiệu suất các sân trực thuộc" FontWeight="Bold" Foreground="#374151" Margin="4,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CourtUtilizations}" AutoGenerateColumns="False" 
                                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên sân" Binding="{Binding CourtName}" Width="100"/>
                                        <DataGridTextColumn Header="Phút đã chơi" Binding="{Binding BookedMinutes, StringFormat='{}{0:N0}p'}" Width="100"/>
                                        <DataGridTextColumn Header="Tỷ lệ (%)" Binding="{Binding UtilizationRate, StringFormat='{}{0:N1}%'}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3: TOP KHÁCH HÀNG CƠ SỞ -->
                <TabItem Header="👑 Khách Hàng Thường Xuyên" FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="0,16,0,0">
                        <Border Background="#F9FAFB" CornerRadius="10" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Danh sách khách hàng thường xuyên của cơ sở" FontWeight="Bold" Foreground="#374151" Margin="4,0,0,12"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding TopCustomers}" AutoGenerateColumns="False" 
                                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã KH" Binding="{Binding CustomerId}" Width="80"/>
                                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding CustomerName}" Width="200"/>
                                        <DataGridTextColumn Header="Số điện thoại" Binding="{Binding Phone}" Width="150"/>
                                        <DataGridTextColumn Header="Số lượt chơi tại cơ sở" Binding="{Binding TotalBookings}" Width="160"/>
                                        <DataGridTextColumn Header="Doanh số phát sinh (VNĐ)" Binding="{Binding TotalSpent, Converter={StaticResource MoneyConverter}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</UserControl>
