<UserControl x:Class="BadmintonManager.Views.Pages.AdminUsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Loaded="UserControl_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Quản lý Tài khoản &amp; Phân quyền Nhân sự"
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Danh sách tài khoản Admin, Quản lý cơ sở (Manager) và Nhân viên lễ tân (Staff)"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Role Filter -->
                <ComboBox ItemsSource="{Binding AvailableRoles}"
                          SelectedItem="{Binding SelectedFilterRole, Mode=TwoWay}"
                          Width="130" Margin="0,0,10,0"
                          materialDesign:HintAssist.Hint="Lọc vai trò"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                <!-- Branch Filter -->
                <ComboBox ItemsSource="{Binding FilterBranches}"
                          SelectedItem="{Binding SelectedFilterBranch, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Width="160" Margin="0,0,10,0"
                          materialDesign:HintAssist.Hint="Lọc cơ sở"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                <!-- Search Box -->
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Tìm username, họ tên..."
                         Width="160" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding LoadUsersCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Command="{Binding LoadUsersCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,10,0" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenAddFormCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Tạo tài khoản" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area: DataGrid + Side Form Drawer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Users DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="1.2*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="1.5*"/>

                        <!-- Role Badge -->
                        <DataGridTemplateColumn Header="Vai trò" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                        <Setter Property="Background" Value="#EDE9FE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="Manager">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="Staff">
                                                        <Setter Property="Background" Value="#CCFBF1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                            <Setter Property="Foreground" Value="#6D28D9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="Manager">
                                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="Staff">
                                                            <Setter Property="Foreground" Value="#0F766E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Cơ sở trực thuộc" Binding="{Binding BranchName, TargetNullValue='(Toàn hệ thống)'}" Width="1.5*"/>

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Hoạt động"/>
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Đã khóa"/>
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action Buttons -->
                        <DataGridTemplateColumn Header="Thao tác" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Chỉnh sửa thông tin"
                                                Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Width="30" Height="30">
                                            <materialDesign:PackIcon Kind="PencilOutline" Foreground="{StaticResource PrimaryBrush}"/>
                                        </Button>

                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Đặt lại mật khẩu"
                                                Command="{Binding DataContext.OpenResetPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Width="30" Height="30">
                                            <materialDesign:PackIcon Kind="LockReset" Foreground="{StaticResource AccentBrush}"/>
                                        </Button>

                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Khóa / Mở khóa tài khoản"
                                                Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Width="30" Height="30">
                                            <materialDesign:PackIcon Kind="LockOutline" Foreground="{StaticResource CancelledBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Side Form Panel for Add/Edit -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                    Width="360"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding FormTitle}"
                                   FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding CloseFormCommand}"
                                HorizontalAlignment="Right" Width="28" Height="28">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                    </Grid>

                    <!-- Input Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Tên đăng nhập (*)"
                                     IsEnabled="{Binding IsCreating}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,16"/>

                            <PasswordBox x:Name="FormPassBox"
                                         materialDesign:HintAssist.Hint="Mật khẩu khởi tạo (*)"
                                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                         Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}"
                                         PasswordChanged="FormPassBox_PasswordChanged"
                                         Margin="0,0,0,16"/>

                            <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Họ và tên (*)"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,16"/>

                            <ComboBox ItemsSource="{Binding AvailableRoles}"
                                      SelectedItem="{Binding FormRole, Mode=TwoWay}"
                                      materialDesign:HintAssist.Hint="Vai trò (*)"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      Margin="0,0,0,16"/>

                            <ComboBox ItemsSource="{Binding FormBranches}"
                                      SelectedItem="{Binding SelectedFormBranch, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      materialDesign:HintAssist.Hint="Thuộc cơ sở (* với Manager/Staff)"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      Margin="0,0,0,20"/>

                            <CheckBox IsChecked="{Binding FormIsActive}"
                                      Content="Cho phép đăng nhập (Kích hoạt)"
                                      Margin="0,0,0,20"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Hủy"
                                Command="{Binding CloseFormCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Margin="0,0,8,0" Width="80"/>
                        <Button Content="Lưu"
                                Command="{Binding SaveUserCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="90"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay Dialog for Reset Password -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Background="#66000000"
              Visibility="{Binding IsResetPasswordOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardBorderStyle}"
                    Width="400"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Đặt lại Mật khẩu Người dùng"
                               FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ResetUsername, StringFormat='Tài khoản: @{0}'}"
                               FontSize="13" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <PasswordBox x:Name="NewPassBox"
                                 materialDesign:HintAssist.Hint="Mật khẩu mới (*)"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                 PasswordChanged="NewPassBox_PasswordChanged"
                                 Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ"
                                Command="{Binding CloseResetPasswordCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Margin="0,0,10,0" Width="90"/>
                        <Button Content="Xác nhận"
                                Command="{Binding ConfirmResetPasswordCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="100"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
