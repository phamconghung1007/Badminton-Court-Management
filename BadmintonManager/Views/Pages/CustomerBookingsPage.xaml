<UserControl x:Class="BadmintonManager.Views.Pages.CustomerBookingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Lịch Sử Đơn Đặt Sân Cá Nhân" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Theo dõi trạng thái các đơn đặt sân, thông tin đặt cọc, thực hiện đổi lịch hoặc hủy đơn theo quy định." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2. KPI Cards Row -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="0,0,10,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Tổng số đơn đặt" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalBookingsCount, StringFormat='{}{0} đơn'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="5,0,5,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Chờ duyệt / cọc (Pending)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PendingBookingsCount, StringFormat='{}{0} đơn'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="5,0,5,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Đã xác nhận (Confirmed)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ConfirmedBookingsCount, StringFormat='{}{0} đơn'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="10,0,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Đã hoàn tất (Completed)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CompletedBookingsCount, StringFormat='{}{0} đơn'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 3. Filter & Search Bar -->
            <Border Grid.Row="2" Style="{StaticResource SurfaceCardBorderStyle}" Margin="0,0,0,16" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Filter by Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Trạng thái: " FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  DisplayMemberPath="DisplayText"
                                  Width="200" Height="36" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Tìm theo mã đơn, tên sân hoặc cơ sở..."
                             Height="36" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding FilterCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="36" Padding="16,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Lọc" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LoadBookingsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="36" Padding="12,0">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Bookings DataGrid -->
            <Border Grid.Row="3" Style="{StaticResource SurfaceCardBorderStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Bookings}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          RowHeight="54"
                          Background="White">
                    <DataGrid.Columns>
                        <!-- Mã đơn -->
                        <DataGridTemplateColumn Header="Mã đơn" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Sân & Chi nhánh -->
                        <DataGridTemplateColumn Header="Sân &amp; Cơ sở" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CourtName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding BranchName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Giờ chơi -->
                        <DataGridTemplateColumn Header="Thời gian chơi" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StartTime, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tiền thanh toán -->
                        <DataGridTemplateColumn Header="Thanh toán" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FinalAmount, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}">
                                            <Run Text="Cọc: "/>
                                            <Run Text="{Binding DepositAmount, StringFormat='{}{0:N0} đ'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Trạng thái -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#F1F5F9">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Thao tác -->
                        <DataGridTemplateColumn Header="Thao tác" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Đổi lịch -->
                                        <Button Command="{Binding DataContext.OpenRescheduleDrawerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Height="32" Padding="8,0" Margin="0,0,4,0"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                ToolTip="Đổi lịch chơi (trước 24h)">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CalendarSync" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Đổi giờ" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Hủy đơn -->
                                        <Button Command="{Binding DataContext.CancelBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Height="32" Padding="8,0"
                                                Foreground="{StaticResource DangerBrush}"
                                                ToolTip="Hủy đơn đặt sân">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Cancel" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Hủy" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- 5. Reschedule Drawer / Overlay Panel -->
        <Grid Visibility="{Binding IsRescheduleDrawerOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#66000000"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="White" Width="420" HorizontalAlignment="Right" Padding="24"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Đổi Lịch Chơi" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedBooking.Code, StringFormat='Đơn đặt sân: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Command="{Binding CloseRescheduleDrawerCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" Width="32" Height="32" Padding="0">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <!-- Drawer Body -->
                    <StackPanel Grid.Row="1">
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SÂN HIỆN TẠI" FontSize="10" FontWeight="Bold" Foreground="#1E40AF"/>
                                <TextBlock Text="{Binding SelectedBooking.CourtName}" FontSize="15" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding SelectedBooking.BranchName}" FontSize="12" Foreground="#3B82F6"/>
                            </StackPanel>
                        </Border>

                        <!-- Ngày mới -->
                        <TextBlock Text="Chọn ngày chơi mới" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding NewDate}" Height="40" Margin="0,0,0,16" VerticalContentAlignment="Center"/>

                        <!-- Giờ bắt đầu mới -->
                        <TextBlock Text="Giờ bắt đầu mới" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding NewStartTime}" Height="40" Margin="0,0,0,16" VerticalContentAlignment="Center"/>

                        <!-- Giờ kết thúc mới -->
                        <TextBlock Text="Giờ kết thúc mới" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding NewEndTime}" Height="40" Margin="0,0,0,16" VerticalContentAlignment="Center"/>

                        <Border Background="#FEF3C7" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                            <TextBlock Text="* Lưu ý: Khung giờ mới sẽ được thẩm định lại quy tắc chống trùng giờ (BR-03) và khoảng trống 30 phút (BR-04)." FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- Drawer Footer Buttons -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseRescheduleDrawerCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="40" Margin="0,0,8,0">
                            <TextBlock Text="Hủy bỏ" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ConfirmRescheduleCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="40" Margin="8,0,0,0">
                            <TextBlock Text="Xác Nhận Đổi" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
