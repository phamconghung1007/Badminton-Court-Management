<UserControl x:Class="BadmintonManager.Views.Pages.CustomerPointsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             Loaded="UserControl_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header & Current Tier Status -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Điểm Tích Lũy &amp; Chính Sách Hội Viên" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Cứ mỗi 10.000đ thanh toán dịch vụ sân, bạn sẽ nhận được 1 điểm thưởng. Đạt đủ điểm hệ thống sẽ tự động nâng hạng thẻ." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Current Tier Card Badge -->
                <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Crown" Width="28" Height="28" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTierName, StringFormat='HẠNG {0}'}" FontWeight="Bold" FontSize="14" Foreground="#92400E"/>
                            <TextBlock FontSize="12" Foreground="#B45309">
                                <Run Text="Điểm: "/>
                                <Run Text="{Binding TotalPoints, StringFormat='{}{0:N0}'}" FontWeight="Bold"/>
                                <Run Text=" | Ưu đãi: "/>
                                <Run Text="{Binding DiscountPercent, StringFormat='{}{0:0.#}%'}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Membership Tiers Policy Row -->
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                <TextBlock Text="Chính sách các hạng hội viên" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <ItemsControl ItemsSource="{Binding MembershipTiers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6" Padding="16" CornerRadius="8" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Tier Header -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="ShieldCheck" Width="24" Height="24" Foreground="{StaticResource RoleCustomerBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name, StringFormat='Hạng {0}'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Requirements & Benefit -->
                                    <StackPanel Grid.Row="1">
                                        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="Điểm tối thiểu: "/>
                                            <Run Text="{Binding MinPoints, StringFormat='{}{0:N0} điểm'}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="13" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0">
                                            <Run Text="Ưu đãi giảm giá: "/>
                                            <Run Text="{Binding DiscountPercent, StringFormat='{}{0:0.#}%'}" FontWeight="Bold"/>
                                            <Run Text=" / giờ chơi"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Auto Upgrade Note -->
                                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="4" Padding="8,4" Margin="0,12,0,0">
                                        <TextBlock Text="Tự động thăng hạng khi đủ điểm" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 3. Point Transactions History -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Lịch sử tích lũy &amp; sử dụng điểm thưởng" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- 4. Point Transactions DataGrid -->
            <Border Grid.Row="3" Style="{StaticResource SurfaceCardBorderStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding PointHistory}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          RowHeight="48"
                          Background="White">
                    <DataGrid.Columns>
                        <!-- Thời gian -->
                        <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="160"/>

                        <!-- Biến động điểm -->
                        <DataGridTemplateColumn Header="Biến động" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Points, StringFormat='{}+{0} điểm'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Số dư điểm -->
                        <DataGridTextColumn Header="Số dư sau GD" Binding="{Binding BalanceAfter, StringFormat='{}{0:N0} điểm'}" Width="140"/>

                        <!-- Lý do -->
                        <DataGridTextColumn Header="Nội dung biến động" Binding="{Binding Reason}" Width="3*"/>

                        <!-- Mã đơn liên quan -->
                        <DataGridTextColumn Header="Mã đơn" Binding="{Binding BookingCode}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
