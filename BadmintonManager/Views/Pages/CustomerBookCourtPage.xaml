<UserControl x:Class="BadmintonManager.Views.Pages.CustomerBookCourtPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Tìm &amp; Đặt Sân Trực Tuyến" 
                           FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Tìm kiếm sân trống theo thời gian thực tại các chi nhánh, tự động áp dụng ưu đãi hội viên và giữ sân nhanh chóng." 
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2. Search Filter Card -->
            <Border Grid.Row="1" Style="{StaticResource SurfaceCardBorderStyle}" Margin="0,0,0,24" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cơ sở -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Cơ sở cầu lông" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Branches}"
                                      SelectedItem="{Binding SelectedBranch}"
                                      DisplayMemberPath="Name"
                                      Height="40" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Ngày chơi -->
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Ngày đặt sân" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding SelectedDate}"
                                        Height="40" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Giờ bắt đầu -->
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="Giờ bắt đầu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding TimeSlots}"
                                      SelectedItem="{Binding SelectedStartTime}"
                                      Height="40" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Giờ kết thúc -->
                        <StackPanel Grid.Column="3" Margin="0,0,16,0">
                            <TextBlock Text="Giờ kết thúc" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding TimeSlots}"
                                      SelectedItem="{Binding SelectedEndTime}"
                                      Height="40" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Nút Tìm sân -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <Button Command="{Binding SearchCourtsCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Height="40" Padding="20,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Tìm Sân Trống" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Status Notification / Summary -->
                    <Border Grid.Row="1" Margin="0,16,0,0" Padding="12,10" CornerRadius="6"
                            Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                            Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SearchSummary}" FontSize="12" Foreground="#1E40AF" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Results & Live Pricing Area -->
            <Grid Grid.Row="2" Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Available Courts List -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Danh sách sân còn trống" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <ItemsControl ItemsSource="{Binding AvailableCourts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="16" CornerRadius="8" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Badminton Court Icon -->
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#E0F2FE" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <materialDesign:PackIcon Kind="Badminton" Width="26" Height="26" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Court Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CourtName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Còn trống" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BranchName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0">
                                                <Run Text="Tổng tiền: "/>
                                                <Run Text="{Binding FinalAmount, StringFormat='{}{0:N0} VNĐ'}" FontWeight="Bold"/>
                                                <Run Text=" (Cọc: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Run Text="{Binding DepositAmount, StringFormat='{}{0:N0} VNĐ'}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                                <Run Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Select Button -->
                                        <Button Grid.Column="2"
                                                Command="{Binding DataContext.SelectCourtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                VerticalAlignment="Center"
                                                Padding="16,8">
                                            <TextBlock Text="Chọn sân này" FontWeight="Bold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Right: Booking Confirmation & Live Price Card -->
                <Border Grid.Column="1" Style="{StaticResource SurfaceCardBorderStyle}" Padding="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Chi tiết đặt sân &amp; Giá" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <!-- Selected Court Badge -->
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SÂN ĐÃ CHỌN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedCourt.CourtName, FallbackValue='(Chưa chọn sân)'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedCourt.BranchName, FallbackValue='Vui lòng chọn 1 sân từ danh sách'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Time & Date -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Thời gian chơi:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="{Binding SelectedStartTime}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding SelectedEndTime}"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Ngày đặt:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedDate, StringFormat='{}{0:dd/MM/yyyy}'}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                        <Separator Margin="0,0,0,16"/>

                        <!-- Price Breakdown -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Giá gốc khung giờ:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N0} VNĐ'}" HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ưu đãi hạng hội viên " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Background="{StaticResource RoleCustomerBrush}" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CustomerTierName}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding DiscountPercent, StringFormat=' (-{0:0.#}%)'}" FontSize="12" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DiscountAmount, StringFormat='{}-{0:N0} VNĐ'}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Tổng tiền thanh toán:" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding FinalAmount, StringFormat='{}{0:N0} VNĐ'}" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        </Grid>

                        <!-- Deposit Highlight -->
                        <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="TIỀN ĐẶT CỌC CẦN CHUYỂN (30%):" FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                                    <TextBlock Text="{Binding DepositAmount, StringFormat='{}{0:N0} VNĐ'}" FontSize="18" FontWeight="Bold" Foreground="#B45309" Margin="0,2,0,0"/>
                                    <TextBlock Text="Làm tròn lên 1.000đ theo BR-11" FontSize="11" Foreground="#92400E" Margin="0,2,0,0"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="CashClock" Width="28" Height="28" Foreground="#B45309" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Confirm Booking Button -->
                        <Button Command="{Binding BookCourtCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="48" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarCheck" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Xác Nhận Đặt Sân Trực Tuyến" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="* Đơn sẽ được chuyển sang trạng thái Chờ duyệt (Pending). Quý khách vui lòng chuyển khoản tiền cọc trong vòng 2 giờ." 
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
