<UserControl x:Class="BadmintonManager.Views.Pages.UserProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Loaded="UserControl_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <TextBlock Grid.Row="0"
                       Text="Hồ sơ tài khoản &amp; Bảo mật"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Card: Profile Info -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="44" Height="44" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Profile.FullName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Profile.Username, StringFormat='@{0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,0,0,16"/>

                        <!-- Details Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Vai trò hệ thống:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Profile.Role}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cơ sở trực thuộc:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Profile.BranchName, TargetNullValue='Toàn hệ thống'}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Số điện thoại:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Profile.Phone, TargetNullValue='Chưa cập nhật'}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Hạng thành viên:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Profile.TierName, TargetNullValue='---'}" FontWeight="SemiBold" Foreground="{StaticResource RoleCustomerBrush}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Điểm tích lũy:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Profile.TotalPoints, StringFormat='{}{0:N0} điểm'}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Ngày tạo tài khoản:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Profile.CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Card: Change Password -->
                <Border Grid.Column="1"
                        Style="{StaticResource CardBorderStyle}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="KeyVariant" Width="28" Height="28" Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Đổi mật khẩu" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,16"/>

                        <!-- Current Password -->
                        <PasswordBox x:Name="TxtCurrentPassword"
                                     PasswordChanged="TxtCurrentPassword_PasswordChanged"
                                     materialDesign:HintAssist.Hint="Mật khẩu hiện tại *"
                                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                     FontSize="13"
                                     Margin="0,0,0,12"/>

                        <!-- New Password -->
                        <PasswordBox x:Name="TxtNewPassword"
                                     PasswordChanged="TxtNewPassword_PasswordChanged"
                                     materialDesign:HintAssist.Hint="Mật khẩu mới (tối thiểu 6 ký tự) *"
                                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                     FontSize="13"
                                     Margin="0,0,0,12"/>

                        <!-- Confirm New Password -->
                        <PasswordBox x:Name="TxtConfirmNewPassword"
                                     PasswordChanged="TxtConfirmNewPassword_PasswordChanged"
                                     materialDesign:HintAssist.Hint="Xác nhận mật khẩu mới *"
                                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                     FontSize="13"
                                     Margin="0,0,0,20"/>

                        <!-- Change Password Button -->
                        <Button Command="{Binding ChangePasswordCommand}"
                                Content="CẬP NHẬT MẬT KHẨU"
                                Height="38"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <!-- Progress Bar -->
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
