<UserControl x:Class="BadmintonManager.Views.Pages.AdminTiersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:BadmintonManager.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Chính sách Hạng Hội Viên &amp; Tích Điểm"
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Cấu hình các cấp độ hội viên, ngưỡng điểm tự động nâng hạng (BR-16) và tỷ lệ giảm giá trực tiếp (BR-09)."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadTiersCommand}"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,12,0" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenAddFormCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Thêm hạng mới" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Info Note Card -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="14" CornerRadius="8" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource PrimaryBrush}" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap">
                    <Run FontWeight="Bold">Quy tắc nghiệp vụ:</Run>
                    <Run>Hệ thống tự động tích lũy 1 điểm cho mỗi 10.000 VNĐ thanh toán thực tế (BR-15). Khi tổng điểm đạt ngưỡng tối thiểu thì tự động nâng hạng ngay lập tức và không bao giờ tự động hạ hạng (BR-16). Chiết khấu giảm giá hạng được lưu cứng trực tiếp vào đơn đặt tại thời điểm tạo (BR-09).</Run>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Main Content Area: Tiers Table & Side Editor -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tiers DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding Tiers}"
                          SelectedItem="{Binding SelectedTier, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Thứ tự" Binding="{Binding SortOrder}" Width="80"/>
                        <DataGridTemplateColumn Header="Tên hạng hội viên" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CardAccountDetailsStar" Width="18" Height="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Ngưỡng điểm tối thiểu" Binding="{Binding MinPoints, StringFormat='{}{0:N0} điểm'}" Width="1.8*" FontWeight="SemiBold"/>
                        
                        <DataGridTemplateColumn Header="Mức giảm giá (%)" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#FEF3C7" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding DiscountText, StringFormat='{}Giảm {0}'}"
                                                   FontWeight="Bold" Foreground="#B45309" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Số hội viên hiện tại" Binding="{Binding CustomerCount, StringFormat='{}{0:N0} khách'}" Width="1.5*"/>

                        <!-- Action Buttons -->
                        <DataGridTemplateColumn Header="Thao tác" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Chỉnh sửa chính sách hạng"
                                                Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Width="32" Height="32">
                                            <materialDesign:PackIcon Kind="PencilOutline" Foreground="{StaticResource PrimaryBrush}"/>
                                        </Button>

                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Xoá hạng (chỉ được xoá khi không có khách)"
                                                Command="{Binding DataContext.DeleteTierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Width="32" Height="32">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#EF4444"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Side Drawer Form for Add/Edit -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                    Width="360"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding FormTitle}"
                                   FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding CloseFormCommand}"
                                HorizontalAlignment="Right" Width="28" Height="28">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                    </Grid>

                    <!-- Form Input Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,4,0">
                            <!-- Tier Name -->
                            <TextBlock Text="Tên hạng hội viên *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Ví dụ: Đồng, Bạc, Vàng, Kim Cương..."
                                     Margin="0,0,0,16"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <!-- Min Points -->
                            <TextBlock Text="Điểm tích lũy tối thiểu (điểm) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormMinPointsText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Ví dụ: 0, 500, 1500..."
                                     Margin="0,0,0,16"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <!-- Discount Percent -->
                            <TextBlock Text="Mức giảm giá trực tiếp (%) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormDiscountPercentText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Ví dụ: 5.0 (tương đương giảm 5%)"
                                     Margin="0,0,0,16"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <!-- Sort Order -->
                            <TextBlock Text="Thứ tự ưu tiên sắp xếp *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Ví dụ: 1, 2, 3..."
                                     Margin="0,0,0,16"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <!-- Error Message Display -->
                            <TextBlock Text="{Binding FormErrorMessage}"
                                       Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"
                                       Visibility="{Binding FormErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Form Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Huỷ bỏ"
                                Command="{Binding CloseFormCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Margin="0,0,8,0" Width="90" Height="36"/>
                        <Button Content="Lưu chính sách"
                                Command="{Binding SaveTierCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
