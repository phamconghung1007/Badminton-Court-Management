<UserControl x:Class="BadmintonManager.Views.Pages.CustomerDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Loaded="UserControl_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Cổng thông tin Khách hàng (Customer Portal)"
                           FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Xin chào: " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding CustomerName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text=" | Hạng: " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                    <Border Background="{StaticResource RoleCustomerBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TierName}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="{Binding DiscountPercent, StringFormat=' (Ưu đãi {0:0.#}%)'}" FontSize="12" Foreground="{StaticResource RoleCustomerBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Stat Cards Row -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,24">
                <!-- Loyalty Points -->
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="StarCircle" Width="28" Height="28" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Điểm tích lũy hiện có" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalPoints, StringFormat='{}{0} điểm'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Active Bookings -->
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="CalendarClock" Width="28" Height="28" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Lịch đặt sắp diễn ra" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ActiveBookingsCount, StringFormat='{}{0} lượt'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Completed Bookings -->
                <Border Style="{StaticResource StatCardBorderStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="CheckDecagram" Width="28" Height="28" Foreground="{StaticResource RoleCustomerBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Lượt chơi đã hoàn thành" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CompletedBookingsCount, StringFormat='{}{0} lượt'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Info Box -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="🏸 Dịch vụ &amp; Quyền lợi thành viên"
                               FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                    <TextBlock Text="• Tra cứu nhanh tình trạng sân trống tại 3 cơ sở (Cầu Giấy, Đống Đa, Thanh Xuân)."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="• Đặt sân trực tuyến theo giờ linh hoạt, thanh toán tiện lợi qua mã VietQR."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="• Quản lý lịch sử đặt sân cá nhân và huỷ lịch theo chính sách hoàn huỷ quy định."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="• Tích điểm nâng hạng hội viên (Đồng 0%, Bạc 5%, Vàng 10%) để nhận giảm giá tự động khi đặt sân."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
